option(
    'with-lua',
    type: 'feature',
    value: 'enabled',
    description: 'embed Lua interpreter for network emulation',
)
option(
    'rpath',
    type: 'boolean',
    value: false,
    yield: true,
    description: 'embed an RPATH so installed binaries find libraries in a (non-standard) libdir',
)
